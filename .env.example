KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=video.queued
KAFKA_CONSUMER_GROUP_ID=meridian-media-processing-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
DATABASE_URL=postgresql+asyncpg://postgres:postgres@media-processing-db:5432/media_processing_db
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_DOWNLOAD_BUCKET=viduploads
MINIO_UPLOAD_BUCKET=vidsegments
MINIO_SECURE=false
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
LOG_LEVEL=info
